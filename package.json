{
  "name": "sachidananda-panigrahi-next-js-boilerplate",
  "homepage": "https://github.com/sachidananda-panigrahi/next-js-boilerplate",
  "bugs": {
    "url": "https://github.com/sachidananda-panigrahi/next-js-boilerplate/issues"
  },
  "author": "sachidananda-panigrahi (https://github.com/sachidananda-panigrahi)",
  "repository": {
    "type": "git",
    "url": "https://github.com/sachidananda-panigrahi/next-js-boilerplate.git"
  },
  "type": "module",
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p dev:*",
    "build:next": "next build",
    "build-local": "next build",
    "build": "next build",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@arcjet/next": "^1.4.0",
    "@hookform/resolvers": "^5.2.2",
    "@logtape/logtape": "^2.0.7",
    "@sentry/nextjs": "^10.52.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "next": "^16.2.6",
    "next-intl": "^4.11.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.59.1",
    "@spotlightjs/spotlight": "^4.11.3",
    "@swc/helpers": "^0.5.21",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "checkly": "^7.13.0",
    "cross-env": "^10.1.0",
    "knip": "^6.12.1",
    "lefthook": "^2.1.6",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.6.5",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "vitest-browser-react": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "lefthook",
      "sharp"
    ],
    "overrides": {
      "postcss": ">=8.5.10"
    }
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
